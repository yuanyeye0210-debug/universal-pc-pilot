+def _inject_handoff_notice(result: Any) -> Any:
+    """Prepend a human-handoff rescan notice to a Snapshot/Screenshot result."""
+    if isinstance(result, str):
+        return f"{_HANDOFF_SYNC_NOTICE}\n\n{result}"
+    if isinstance(result, list):
+        if result and isinstance(result[0], str):
+            return [f"{_HANDOFF_SYNC_NOTICE}\n\n{result[0]}", *result[1:]]
+        try:
+            from mcp.types import TextContent
+
+            return [TextContent(type="text", text=_HANDOFF_SYNC_NOTICE), *result]
+        except Exception:
+            return [_HANDOFF_SYNC_NOTICE, *result]
+    content = getattr(result, "content", None)
+    if isinstance(content, list):
+        try:
+            from mcp.types import TextContent
+
+            content.insert(0, TextContent(type="text", text=_HANDOFF_SYNC_NOTICE))
+        except Exception:
+            pass
+    return result
