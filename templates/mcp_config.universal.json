{
  "mcpServers": {
    "windows-mcp": {
      "command": "uvx",
      "args": [
        "windows-mcp",
        "serve",
        "--no-control"
      ],
      "env": {
        "WINDOWS_MCP_DISABLE_FLASH": "1"
      }
    },
    "playwright-edge": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "msedge"
      ]
    },
    "context-mode": {
      "command": "npx",
      "args": [
        "-y",
        "context-mode",
        "server"
      ]
    }
  }
}
