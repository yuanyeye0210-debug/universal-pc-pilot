+            y0 = max(0, int(cy - dot_r - 2 * scale))
+            y1 = min(size, int(cy + dot_r + 2 * scale + 1))
+            for y in range(y0, y1):
+                for x in range(x0, x1):
+                    dist = math.hypot(x - cx, y - cy)
+                    if dist <= dot_r + scale:
+                        cov = min(1.0, max(0.0, (dot_r + scale - dist) / scale))
+                        # Subtle outer rim makes gray dots crisp on pure white backgrounds.
+                        is_rim = dist > dot_r - 0.6 * scale
+                        c = rim_color if is_rim else dot_color
+                        alpha = round((a_peak * (0.55 if is_rim else 1.0)) * cov)
+                        if alpha > px[x, y][3]:
+                            px[x, y] = (*c, alpha)
+        downsampled = image.resize((_SPINNER_SIZE, _SPINNER_SIZE), Image.Resampling.LANCZOS)
+        frames.append(premultiplied_bgra(downsampled, 1.0))
+    return frames
+
+
