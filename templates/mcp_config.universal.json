{
  "mcpServers": {
    "windows-mcp": {
      "command": "uvx",
      "args": [
        "windows-mcp",
        "serve",
        "--control",
        "--control-idle-timeout",
        "2.5",
        "--control-policy",
        "balanced"
      ],
      "env": {
        "WINDOWS_MCP_DISABLE_FLASH": "1",
        "WINDOWS_MCP_OVERLAY_MODE": "spinner",
        "WINDOWS_MCP_YIELD_ON_ANY_INPUT": "1",
        "WINDOWS_MCP_CONSENT_COUNTDOWN": "0"
      }
    },
    "playwright-edge": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "msedge"
      ]
    },
    "context-mode": {
      "command": "npx",
      "args": [
        "-y",
        "context-mode",
        "server"
      ]
    }
  }
}
