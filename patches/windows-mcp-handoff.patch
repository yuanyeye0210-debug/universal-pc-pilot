diff --git a/tests/test_human_handoff_spinner.py b/tests/test_human_handoff_spinner.py
new file mode 100644
index 0000000..cef51e5
--- /dev/null
+++ b/tests/test_human_handoff_spinner.py
@@ -0,0 +1,216 @@
+"""Tests for instant human handoff, forced rescan gate, and spinner overlay."""
+
+from __future__ import annotations
+
+import ctypes
+import json
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from fastmcp import Client, FastMCP
+
+from windows_mcp.desktop import control_hooks, control_overlay, control_overlay_art
+from windows_mcp.desktop.control import ControlBlocked, ControlCoordinator
+from windows_mcp.infrastructure.config import load_config
+from windows_mcp.tools.control_notifications import ControlNotifier, ControlToolGate
+
+
+def _make_ready_coordinator(*, idle_timeout: float = 0.15) -> ControlCoordinator:
+    coord = ControlCoordinator()
+    coord.enabled = True
+    coord.policy = "balanced"
+    coord.idle_timeout_seconds = idle_timeout
+    coord.yield_on_any_input = True
+    coord._state = "ai"
+    coord._suppress = True
+    coord._visual_armed = True
+    coord._had_ai_control = True
+    coord._deadline = time.monotonic() + 5.0
+    coord._last_point = (100, 100)
+    return coord
+
+
+def test_yield_on_any_input_never_swallows_and_sets_rescan(monkeypatch):
+    monkeypatch.setattr(control_hooks._user32, "CallNextHookEx", lambda *args: 0)
+
+    # 1. Mouse move >= 4px immediately yields without swallowing
+    coord = _make_ready_coordinator()
+    data = control_hooks._MouseHookData(
+        pt=control_hooks._user32.GetAsyncKeyState and ctypes.wintypes.POINT(105, 100),
+        mouseData=0,
+        flags=0,
+        time=0,
+        dwExtraInfo=0,
+    )
+    ret = control_hooks.physical_mouse(coord, 0, 0x200, ctypes.addressof(data))
+    assert ret == 0
+    assert coord._suppress is False
+    assert coord._needs_rescan is True
+    assert coord._fast_takeover is True
+    event = coord._events.get_nowait()
+    assert event[0] == "yield"
+    coord._handle(event)
+    assert coord.status()["state"] == "user"
+
+    # 2. Mouse click & wheel immediately yield without swallowing
+    for msg in (0x201, 0x20A):
+        coord2 = _make_ready_coordinator()
+        d2 = control_hooks._MouseHookData(
+            pt=ctypes.wintypes.POINT(100, 100),
+            mouseData=(120 << 16) if msg == 0x20A else 0,
+            flags=0,
+            time=0,
+            dwExtraInfo=0,
+        )
+        assert control_hooks.physical_mouse(coord2, 0, msg, ctypes.addressof(d2)) == 0
+        assert coord2._suppress is False
+        assert coord2._needs_rescan is True
+        assert coord2._events.get_nowait()[0] == "yield"
+
+    # 3. Any physical keyboard press immediately yields without swallowing
+    coord3 = _make_ready_coordinator()
+    kdata = control_hooks._KeyHookData(vkCode=0x41, scanCode=0x1E, flags=0, time=0, dwExtraInfo=0)
+    assert control_hooks.physical_key(coord3, 0, 0x100, ctypes.addressof(kdata)) == 0
+    assert coord3._suppress is False
+    assert coord3._needs_rescan is True
+    assert coord3._events.get_nowait()[0] == "yield"
+
+
+def test_rescan_required_blocks_action_until_enter_thinking():
+    coord = _make_ready_coordinator(idle_timeout=0.1)
+    coord.input_ledger.enable()
+    coord._handle(("yield",))
+    assert coord.status()["state"] == "user"
+    assert coord.needs_rescan is True
+
+    # Wait until idle_timeout expires -> state becomes ready, but RESCAN_REQUIRED still blocks.
+    time.sleep(0.15)
+    st = coord.status()
+    assert st["state"] == "ready"
+    assert st["needs_rescan"] is True
+
+    with pytest.raises(ControlBlocked) as exc:
+        coord.begin_call("Click")
+    assert exc.value.code == "RESCAN_REQUIRED"
+
+    # Simulate Snapshot/Screenshot completing cleanly.
+    res = coord.enter_thinking(min_stamp=coord.last_physical_event)
+    assert res["state"] == "ai"
+    assert res["needs_rescan"] is False
+
+    token = coord.begin_call("Click")
+    assert token > 0
+    coord.end_call(token)
+
+
+@pytest.mark.asyncio
+async def test_mcp_gate_waits_for_user_idle_rescan_and_blocks_blind_click():
+    coord = _make_ready_coordinator(idle_timeout=0.15)
+    coord.input_ledger.enable()
+    coord._handle(("yield",))
+
+    mcp = FastMCP("handoff-test")
+    notifier = ControlNotifier(coord)
+    mcp.add_middleware(ControlToolGate(coord, notifier))
+    clicked = []
+
+    @mcp.tool(name="Click")
+    def click_tool():
+        clicked.append(True)
+        return "clicked"
+
+    @mcp.tool(name="Snapshot")
+    def snapshot_tool():
+        return ["desktop state ok"]
+
+    async with Client(mcp) as client:
+        # 1. Calling Click while user is active -> USER_CONTROL
+        err1 = await client.call_tool("Click", raise_on_error=False)
+        assert err1.is_error
+        payload1 = json.loads(err1.content[0].text)
+        assert payload1["code"] == "USER_CONTROL"
+        assert "2.5 秒" in payload1["message"]
+
+        # 2. Wait for user idle timeout -> Click is still blocked by RESCAN_REQUIRED
+        time.sleep(0.2)
+        err2 = await client.call_tool("Click", raise_on_error=False)
+        assert err2.is_error
+        payload2 = json.loads(err2.content[0].text)
+        assert payload2["code"] == "RESCAN_REQUIRED"
+        assert "Snapshot" in payload2["message"]
+        assert clicked == []
+
+        # 3. Trigger user state again and call Snapshot -> waits for idle, returns handoff notice, enters ai thinking
+        coord._last_physical_event = time.monotonic()
+        coord._handle(("yield",))
+        snap = await client.call_tool("Snapshot")
+        assert "[HUMAN_HANDOFF_SYNC]" in str(snap.content[0].text)
+        assert coord.status()["state"] == "ai"
+        assert coord.needs_rescan is False
+
+        # 4. Now Click succeeds
+        ok = await client.call_tool("Click")
+        assert not ok.is_error
+        assert clicked == [True]
+
+
+def test_spinner_frames_and_overlay_mode(monkeypatch):
+    frames = control_overlay_art._spinner_frames(control_overlay._BLUE)
+    assert len(frames) == control_overlay_art._SPINNER_FRAMES == 16
+    expected_bytes = control_overlay_art._SPINNER_SIZE * control_overlay_art._SPINNER_SIZE * 4
+    assert all(len(f) == expected_bytes for f in frames)
+    assert len(set(frames)) == 16
+
+    created = []
+
+    class DummyLayer:
+        def __init__(self, x, y, w, h, bgra, name, *, breathes=True):
+            created.append((x, y, w, h, name, breathes))
+
+    monkeypatch.setenv("WINDOWS_MCP_OVERLAY_MODE", "spinner")
+    monkeypatch.setattr(control_overlay, "_Layer", DummyLayer)
+    monkeypatch.setattr(
+        control_overlay._user32,
+        "GetCursorPos",
+        lambda ptr: setattr(ptr._obj, "x", 300) or setattr(ptr._obj, "y", 400) or True,
+    )
+    layers, ring = control_overlay._build_layers(((0, 0, 1920, 1080),), pending=False)
+    assert layers == []
+    assert isinstance(ring, DummyLayer)
+    assert len(created) == 1
+    assert created[0][4] == "cursor"
+    assert created[0][2] == control_overlay_art._SPINNER_SIZE
+
+
+def test_system_cursor_hide_and_restore(monkeypatch):
+    calls = []
+    monkeypatch.setattr(control_overlay._user32, "CreateCursor", lambda *args: 12345)
+    monkeypatch.setattr(
+        control_overlay._user32,
+        "SetSystemCursor",
+        lambda h, ocr_id: calls.append(("set", h, ocr_id)) or True,
+    )
+    monkeypatch.setattr(
+        control_overlay._user32,
+        "SystemParametersInfoW",
+        lambda action, p1, p2, f: calls.append(("restore", action)) or True,
+    )
+    control_overlay._cursor_hidden = False
+    control_overlay._hide_system_cursor()
+    assert control_overlay._cursor_hidden is True
+    assert len([c for c in calls if c[0] == "set"]) == len(control_overlay._OCR_IDS)
+    control_overlay._restore_system_cursor()
+    assert control_overlay._cursor_hidden is False
+    assert ("restore", control_overlay._SPI_SETCURSORS) in calls
+
+
+def test_user_config_toml_loads_expected_settings():
+    cfg_path = Path("~/.windows-mcp/config.toml").expanduser()
+    cfg = load_config(cfg_path)
+    assert cfg.control.enabled is True
+    assert cfg.control.policy == "balanced"
+    assert cfg.control.idle_timeout_seconds == 2.5
+    assert cfg.control.consent_countdown_seconds == 0
+    assert cfg.control.mouse_takeover_units == 40
